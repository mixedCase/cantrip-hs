cabal-version:      3.0
name:               cantrip-hs
version:            0.1.0
synopsis:           Batteries-included Haskell scripting, Nix-native
description:
  A small standard library for everyday Haskell scripts: JSON,
  HTTP, running commands, atomic file writes, locks, CLI entry points. Single
  @import Cantrip@. POSIX only.
license:            BSD-3-Clause
author:             Andrés Rodríguez
maintainer:         hello@andres.codes
category:           System
homepage:           https://github.com/mixedCase/cantrip-hs
bug-reports:        https://github.com/mixedCase/cantrip-hs/issues
tested-with:        GHC ==9.10.3
extra-doc-files:    README.md
                   CHANGELOG.md
license-files:      LICENSE

source-repository head
  type: git
  location: https://github.com/mixedCase/cantrip-hs

library
  exposed-modules:
    Cantrip
    Cantrip.Core
    Cantrip.Cli
    Cantrip.Json
    Cantrip.Encoding
    Cantrip.Http
    Cantrip.Shell
    Cantrip.Fs
    Cantrip.Time
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.20 && < 5,
    aeson >= 2.2 && < 3,
    aeson-pretty >= 0.8 && < 1,
    base16-bytestring >= 1 && < 2,
    base64-bytestring >= 1 && < 2,
    bytestring >= 0.11 && < 1,
    directory >= 1.3 && < 2,
    filepath >= 1.4 && < 2,
    http-client >= 0.7 && < 1,
    http-conduit >= 2.3.8 && < 3,
    http-types >= 0.12 && < 1,
    iso8601-time >= 0.1 && < 1,
    process >= 1.6 && < 2,
    scientific >= 0.3 && < 1,
    text >= 2 && < 3,
    vector >= 0.12 && < 1,
    time >= 1.12 && < 2,
    typed-process >= 0.2.11 && < 0.3,
    unix >= 2.8 && < 3,
    stm >= 2.5 && < 3,
    cantrip-hs:syntax

-- The [sh|...|] quasi-quoter, kept apart so running it loads only these
-- dependencies at compile time (see Cantrip.Shell.Syntax).
library syntax
  visibility: public
  exposed-modules: Cantrip.Shell.Syntax
  hs-source-dirs: syntax
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.20 && < 5,
    bytestring >= 0.11 && < 1,
    template-haskell >= 2.22 && < 3,
    text >= 2 && < 3,

test-suite cantrip-hs-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  build-depends:
    base,
    aeson,
    bytestring,
    directory,
    network,
    text,
    time,
    typed-process,
    unix,
    cantrip-hs,
    cantrip-hs:syntax,
